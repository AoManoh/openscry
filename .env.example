# openscry configuration
# Copy to .env and fill in real values. .env is gitignored and must never be committed.

# Required: OpenAI-compatible base URL of grok2api (include the /v1 prefix).
GROK_API_URL=https://your-grok2api-host/v1

# Required: API key for grok2api.
GROK_API_KEY=your-api-key

# Required: the model to use. User-supplied; there is no built-in default.
# An unavailable model fails explicitly rather than silently switching.
GROK_MODEL=

# Optional: single-request timeout. Accepts a Go duration ("2m") or bare
# seconds ("120"). Default 120s, clamped to [5s, 600s].
GROK_REQUEST_TIMEOUT=120s

# Optional: MCP engine concurrency (worker pool) and request queue size
# (backpressure). Clamped to [1,100] and [1,10000] respectively. These bound
# MCP request *processing* and apply to the stdio transport only.
GROK_CONCURRENCY=8
GROK_QUEUE_SIZE=64

# Optional: global cap on simultaneous in-flight grok2api calls, shared across
# search, web_search_batch fan-out and fetch, honored in BOTH stdio and HTTP.
# This bounds actual upstream load (distinct from GROK_CONCURRENCY, which
# bounds request processing). Default 32, clamped to [1,256]; set 0 to disable.
GROK_UPSTREAM_CONCURRENCY=32

# Optional: search provider mode. auto|chat|responses (default auto, which
# resolves to chat for a grok2api host). "responses" is a reserved seam and
# currently fails loud — it is not yet implemented.
GROK_SEARCH_PROVIDER=auto

# Optional: hosted (server-side) search tools declared on every search request
# as tools:[{"type":...}] with tool_choice:"auto". Comma-separated, default
# web_search. grok2api v3's Console route only runs tools the client declares,
# so without this the model answers from training knowledge with no sources.
# Add x_search for X (Twitter) content -- Console models only; the Grok Web
# route rejects it with an upstream 400 that openscry surfaces as-is.
# Set to none to disable and restore the legacy model/messages/stream request.
# Applies to web_search / web_search_batch / async search tasks only.
GROK_SEARCH_TOOLS=web_search

# Optional: web_fetch extractor providers. Each tier is enabled only when its
# key is set; otherwise that tier is skipped. Order: Tavily -> Firecrawl ->
# Grok -> basic HTTP. URLs default to the public endpoints.
# TAVILY_API_KEY=
# TAVILY_API_URL=https://api.tavily.com
# FIRECRAWL_API_KEY=
# FIRECRAWL_API_URL=https://api.firecrawl.dev

# Optional: web_fetch degradation policy. full|strict (default full).
# "full"   -- run the whole chain down to basic-HTTP; visible degradation.
# "strict" -- disable basic-HTTP; extractor/model failure fails loud.
GROK_FETCH_FALLBACK=full

# Optional: verbose logging to stderr.
GROK_DEBUG=false
